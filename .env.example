# ==================================================
# Application Settings
# ==================================================
APP_ENV=development              # Application environment (development | staging | test | production)
PROJECT_NAME="Web Assistant"     # Human-readable project name
VERSION=1.0.0                    # Application version
API_VERSION="/api/v1"           # API version prefix for routing
PROJECT_ROOT="root/project"      # Project Root

# ==================================================
# Logging Settings
# ==================================================
DEBUG=true                      # Enable debug mode (disable in production)
DEBUG_DB=false                  # Enable debug mode for database queries (disable in production)
LOG_LEVEL="DEBUG"               # Log level (DEBUG | INFO | WARNING | ERROR)
LOG_RENDERER="console"          # Log renderer (console | json)
LOG_DIR="storage/logs"          # Directory for application logs
LOG_MAX_BYTES=10485760          # Maximum log file size in bytes (10 MB)
LOG_BACKUP_COUNT=10             # Number of backup log files to keep

# ==================================================
# Database (PostgreSQL) Settings
# ==================================================
POSTGRES_HOST=localhost                # Database host (Docker service name or hostname)
POSTGRES_DB=mydb                # Database name
POSTGRES_USER=myuser            # Database username
POSTGRES_PORT=5432              # Database port
POSTGRES_PASSWORD=mypassword    # Database password

# Connection pooling settings
POSTGRES_POOL_SIZE=5            # Base number of persistent DB connections
POSTGRES_MAX_OVERFLOW=10        # Extra connections allowed above pool size

# ==================================================
# JWT (Authentication) Settings
# ==================================================
JWT_SECRET_KEY="your-jwt-secret-key"  # Secret used to sign JWT tokens
JWT_ALGORITHM=HS256                    # JWT signing algorithm
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30     # Access token expiration time (in minutes)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7        # Refresh token expiration time (in days)
SESSION_ABSOLUTE_LIFETIME_DAYS=30       # Absolute lifetime of a session (in days)

# ==================================================
# Rate Limiting Settings
# ==================================================
# Format: "[count] per [n] [second|minute|hour|day]"
# Multiple limits: comma-separated e.g. "5 per minute, 20 per hour"
RATE_LIMIT_DEFAULT="100 per minute"
RATE_LIMIT_HEALTH="300 per minute"
RATE_LIMIT_REGISTER="5 per minute, 20 per hour"
RATE_LIMIT_LOGIN="10 per minute, 50 per hour"
RATE_LIMIT_REFRESH="60 per minute, 500 per hour"
RATE_LIMIT_CREATE_CHAT_SESSION="30 per minute"
RATE_LIMIT_GET_CHAT_SESSIONS="120 per minute"
RATE_LIMIT_GET_CHAT_SESSION="120 per minute"
RATE_LIMIT_UPDATE_CHAT_SESSION="30 per minute"
RATE_LIMIT_DELETE_CHAT_SESSION="20 per minute"
